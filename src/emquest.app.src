{application, emquest, [
    {description, "Client Emquest — semantic search dispatcher"},
    {vsn, "0.2.0"},
    {registered, [emquest_pop, em_librarian]},
    {mod, {emquest_app, []}},
    {applications, [
        kernel,
        stdlib,
        inets,
        cowboy,
        kvex
    ]},
    {env, []},
    {modules, [
        emquest_app,
        emquest_sup,
        emquest_handler,
        emquest_pop,
        emquest_cli,
        queen,
        em_filter_vec,
        em_pop_node,
        em_pop_http,
        em_hf,
        em_librarian,
        em_agent,
        agent_router
    ]},
    {licenses, ["Apache 2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/Emquest"}]}
]}.
